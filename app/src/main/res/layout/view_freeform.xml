<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/freeform_window_background"
    android:clipToOutline="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_surface"
        android:tag="veilView"
        android:visibility="gone">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:tag="veilAppIcon" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="30dp"
        android:layout_gravity="top|center_horizontal"
        android:contentDescription="@string/freeform_window_controls"
        android:focusable="true"
        android:tag="moveHandle">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:background="@drawable/floating_control_background"
            android:importantForAccessibility="no"
            android:scaleType="centerInside"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:src="@drawable/ic_move_handle"
            android:tag="moveHandleIcon"
            android:tint="@android:color/white" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_gravity="bottom"
        android:layoutDirection="ltr"
        android:orientation="horizontal"
        android:tag="bottomBarView">

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:tag="leftScaleView">

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:background="@drawable/resize_handle" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="@string/freeform_back"
                android:focusable="true"
                android:tag="gesturePillTouchView">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="2dp"
                    android:importantForAccessibility="no"
                    android:minWidth="84dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/floating_control_background" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="4dp"
                    android:layout_gravity="center"
                    android:alpha="0.8"
                    android:minWidth="52dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/floating_control_indicator"
                    android:tag="gesturePill" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="@string/freeform_back"
                android:focusable="true"
                android:tag="arrowBack"
                android:visibility="gone">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/floating_control_background"
                    android:importantForAccessibility="no"
                    android:padding="4dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@android:color/white" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:tag="rightScaleView">

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:background="@drawable/resize_handle" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
